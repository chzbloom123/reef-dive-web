# Installed packages: rebuilt from package.json with `npm install`, never committed.
node_modules/

# Vite's build output: regenerated by `npm run build` (Vercel builds it itself).
dist/

# Screenshot history is kept locally only (see CLAUDE.md).
screenshots/*
!screenshots/.gitkeep

# Vercel CLI link info (machine-specific).
.vercel/

# OS / editor clutter
.DS_Store
Thumbs.db
*.log
